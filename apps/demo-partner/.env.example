# Origin Reserva FE-a sa kog se učitava /widget.js (bez završnog /)
VITE_RESERVA_ORIGIN=http://localhost:5173
# Javni ID client application-a partnera "Beogradski Berberin" u Reserva-i
VITE_DEMO_CLIENT_ID=
# Lokacija sa odobrenom saglasnošću: "Beogradski Berberin - Dorćol"
VITE_DEMO_LOCATION_ID=bec8f7fe-acce-4f57-ae21-92cd64eb1b07
# Lokacija BEZ saglasnosti biznisa: widget javi onUnavailable, sajt prikaže kontakt
VITE_DEMO_NO_CONSENT_LOCATION_ID=
# Google OAuth Client ID (Web, javna vrednost)
VITE_GOOGLE_CLIENT_ID=1007490113213-9c0jfm9074fejij8r3s6ea41t6g74eld.apps.googleusercontent.com
# "test" = ID token stiže iz window/query parametra umesto Google-a (samo E2E i lokalno,
# ne postoji u produkcijskom build-u). Ostavi prazno za Google prijavu.
VITE_DEMO_IDENTITY=
