# Local dev (vite dev server)
BASE_DOMAIN=localhost:3000

VITE_AUTH_BASE_URL=http://localhost:8081/auth
VITE_RESOURCE_BASE_URL=http://localhost:8080/api
VITE_OAUTH_CLIENT_ID=reservation
VITE_OAUTH_CLIENT_SECRET=secret
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/callback
# Kontakt email na stranicama /privacy i /terms (opciono; podrazumevano privacy@reserva.example).
VITE_LEGAL_CONTACT_EMAIL=privacy@reserva.example

# Staging (Raspberry Pi, via compose.yaml + Traefik) — copy this file to .env,
# comment the local-dev block above, and uncomment below. These are
# baked into the JS bundle at `docker build` time (Vite env vars are
# build-time only), so a rebuild + redeploy is required after changing them.
# BASE_DOMAIN is also required by compose.yaml for the Traefik Host() rule.
# BASE_DOMAIN=bojanlab.com
# VITE_AUTH_BASE_URL=https://reserva.bojanlab.com/auth
# VITE_RESOURCE_BASE_URL=https://reserva.bojanlab.com/api
# VITE_OAUTH_CLIENT_ID=reservation
# VITE_OAUTH_CLIENT_SECRET=change-me
# VITE_OAUTH_REDIRECT_URI=https://reserva.bojanlab.com/callback
# VITE_LEGAL_CONTACT_EMAIL=change-me@example.com

# Booking widget (/widget/): origin-i kojima je dozvoljeno da ugrade iframe, razmakom odvojeni.
# Runtime env (nginx envsubst u image-u, `vite preview` u E2E) — NIJE VITE_ ključ i ne ulazi u bundle.
# Ostatak FE-a ostaje na `frame-ancestors 'self'`.
# WIDGET_FRAME_ANCESTORS=https://demo-business.bojanlab.com http://localhost:3000 http://localhost:5175 http://127.0.0.1:5175
